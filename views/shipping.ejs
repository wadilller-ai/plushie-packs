<%- include('partials/header', { config }) %>

<section class="card">
  <h1 class="h1">Shipping</h1>
  <p class="muted">Enter your shipping info.</p>

  <div class="summary">
    <div>
      <div class="muted">Item</div>
      <div><b><%= product.name %></b> — <%= option.name %></div>
      <div class="muted small">$<%= unitPrice.toFixed(2) %> each</div>
      <% if (option.minQty && option.minQty > 1) { %>
        <div class="muted small">Minimum qty: <b><%= option.minQty %></b></div>
      <% } %>
    </div>
    <div>
      <div class="muted">Qty</div>
      <div><%= qty %></div>
      <% if (!option.minQty && unitPrice !== Number(option.price)) { %>
        <div class="discountTag" style="margin-top:6px;">Bulk discount applied ✅</div>
      <% } %>
    </div>
    <div>
      <div class="muted">Subtotal</div>
      <div class="total">$<%= subtotalUsd.toFixed(2) %></div>
      <div class="muted small">Shipping: $<%= shippingUsd.toFixed(2) %></div>
      <div class="muted small"><b>Total: $<%= totalUsd.toFixed(2) %></b></div>
    </div>
  </div>

  <hr class="hr" />

  <form method="POST" action="/shipping" class="grid">
    <input type="hidden" name="product_id" value="<%= product.id %>"/>
    <input type="hidden" name="option_id" value="<%= option.id %>"/>
    <input type="hidden" name="qty" value="<%= qty %>"/>

    <h2 class="h2 full">Shipping Address</h2>

    <div class="grid2 full">
      <div>
        <label>Full Name</label>
        <input name="ship_name" required />
      </div>
      <div>
        <label>Country</label>
        <input name="ship_country" value="USA" required />
      </div>

      <div class="full">
        <label>Address Line 1</label>
        <input name="ship_line1" required />
      </div>

      <div class="full">
        <label>Address Line 2 (optional)</label>
        <input name="ship_line2" />
      </div>

      <div>
        <label>City</label>
        <input name="ship_city" required />
      </div>

      <div>
        <label>State</label>
        <input name="ship_state" required />
      </div>

      <div>
        <label>ZIP</label>
        <input name="ship_zip" required />
      </div>
    </div>

    <div class="optional full">
      <label>Contact (optional: email or Telegram @)</label>
      <input name="contact" placeholder="you@example.com or @username" />
    </div>

    <button class="btn full" type="submit">Continue to Payment</button>
  </form>
</section>

<%- include('partials/footer') %>
