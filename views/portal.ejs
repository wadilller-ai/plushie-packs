<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= config.brand.siteName %> — Portal</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body class="portalPage">
  <div class="portalNebula"></div>
  <div class="portalStars" aria-hidden="true"></div>

  <main class="portalShell" id="portalShell">

    <% if (error) { %>
      <div class="error" style="max-width:540px;"><%= error %></div>
    <% } %>

    <button class="portalCore" id="enterCore" type="button" aria-label="Enter Portal">
      <span class="portalRing ringA"></span>
      <span class="portalRing ringB"></span>
      <img class="portalMascot" src="/public/img/yellow-bear-logo.svg" alt="Plushie Packs yellow bear logo" />
      <span class="portalPulse"></span>
    </button>

    <button class="portalEnter" id="enterButton" type="button">Open Portal</button>

    <div class="authDeck" id="authDeck" aria-hidden="true">
      <section class="authCard">
        <h2>Member Access</h2>
        <p class="muted small">Already holding a key? Authenticate to proceed.</p>
        <form method="POST" action="/auth/login">
          <label>Handle</label>
          <input name="handle" required placeholder="your-handle" autocomplete="username"/>
          <label>Passcode</label>
          <input name="pass" type="password" required placeholder="••••••••" autocomplete="current-password"/>
          <button class="btn" type="submit">Access Vault</button>
        </form>
      </section>

      <section class="authCard">
        <h2>Request Access</h2>
        <p class="muted small">Create your private identity and unlock the portal.</p>
        <form method="POST" action="/auth/register">
          <label>Handle</label>
          <input name="handle" required minlength="3" placeholder="new-handle" autocomplete="username"/>
          <label>Passcode</label>
          <input name="pass" type="password" required minlength="6" placeholder="At least 6 characters" autocomplete="new-password"/>
          <button class="btn" type="submit">Create Access</button>
        </form>
      </section>
    </div>

    <% if (memberUser) { %>
      <div class="portalMemberActions">
        <a class="btn" href="/vault">Continue as @<%= memberUser.handle %></a>
        <form method="POST" action="/auth/logout">
          <button class="btn btn-small" type="submit">Logout</button>
        </form>
      </div>
    <% } %>
  </main>

  <div class="portalBuddies" aria-hidden="true">
    <img class="buddy buddy-1" src="/public/img/portal-buddy-strawberry.svg" alt="" />
    <img class="buddy buddy-2" src="/public/img/portal-buddy-orange.svg" alt="" />
    <img class="buddy buddy-3" src="/public/img/portal-buddy-grape.svg" alt="" />
    <img class="buddy buddy-4" src="/public/img/portal-buddy-pineapple.svg" alt="" />
    <img class="buddy buddy-5" src="/public/img/portal-buddy-cherry.svg" alt="" />
    <img class="buddy buddy-6" src="/public/img/portal-buddy-blueberry.svg" alt="" />
    <img class="buddy buddy-7" src="/public/img/portal-buddy-peach.svg" alt="" />
  </div>


  <script>
    const stars = document.querySelector('.portalStars');
    for (let i = 0; i < 80; i++) {
      const dot = document.createElement('span');
      dot.className = 'star';
      dot.style.left = `${Math.random() * 100}%`;
      dot.style.top = `${Math.random() * 100}%`;
      dot.style.animationDelay = `${Math.random() * 6}s`;
      dot.style.opacity = (Math.random() * 0.8 + 0.15).toFixed(2);
      stars.appendChild(dot);
    }

    const enterCore = document.getElementById('enterCore');
    const enterButton = document.getElementById('enterButton');
    const authDeck = document.getElementById('authDeck');
    const shell = document.getElementById('portalShell');
    const buddyNodes = Array.from(document.querySelectorAll('.buddy'));

    function revealDeck() {
      authDeck.classList.add('open');
      authDeck.setAttribute('aria-hidden', 'false');
      shell.classList.add('entered');
    }

    function cinematicEnter() {
      shell.classList.add('transitioning');
      setTimeout(revealDeck, 550);
    }

    enterCore.addEventListener('click', cinematicEnter);
    enterButton.addEventListener('click', cinematicEnter);

    if (buddyNodes.length) {
      const buddies = [];
      let lastTs = performance.now();
      let initialized = false;

      function randomSpeed() {
        return (Math.random() * 45 + 60) * (Math.random() > 0.5 ? 1 : -1);
      }

      function nodeSize(node) {
        const styleW = parseFloat(getComputedStyle(node).width);
        return Number.isFinite(styleW) && styleW > 10 ? styleW : (window.innerWidth <= 860 ? 80 : 120);
      }

      function clampToScreen(b) {
        const maxX = Math.max(0, window.innerWidth - b.size);
        const maxY = Math.max(0, window.innerHeight - b.size);
        b.x = Math.max(0, Math.min(maxX, b.x));
        b.y = Math.max(0, Math.min(maxY, b.y));
      }

      function setupBuddies(resetVelocity = false) {
        const maxW = window.innerWidth;
        const maxH = window.innerHeight;

        if (!buddies.length) {
          buddyNodes.forEach((node) => {
            const size = nodeSize(node);
            const x = Math.random() * Math.max(1, maxW - size);
            const y = Math.random() * Math.max(1, maxH - size);
            buddies.push({
              node,
              x,
              y,
              vx: randomSpeed(),
              vy: randomSpeed(),
              size,
              radius: size * 0.42,
            });
          });
        } else {
          for (const b of buddies) {
            b.size = nodeSize(b.node);
            b.radius = b.size * 0.42;
            clampToScreen(b);
            if (resetVelocity) {
              b.vx = randomSpeed();
              b.vy = randomSpeed();
            }
          }
        }
      }

      function bounceWalls(b) {
        const maxX = Math.max(0, window.innerWidth - b.size);
        const maxY = Math.max(0, window.innerHeight - b.size);

        if (b.x <= 0) {
          b.x = 0;
          b.vx = Math.abs(b.vx);
        } else if (b.x >= maxX) {
          b.x = maxX;
          b.vx = -Math.abs(b.vx);
        }

        if (b.y <= 0) {
          b.y = 0;
          b.vy = Math.abs(b.vy);
        } else if (b.y >= maxY) {
          b.y = maxY;
          b.vy = -Math.abs(b.vy);
        }
      }

      function collide(a, b) {
        const ax = a.x + a.size / 2;
        const ay = a.y + a.size / 2;
        const bx = b.x + b.size / 2;
        const by = b.y + b.size / 2;
        const dx = bx - ax;
        const dy = by - ay;
        const dist = Math.hypot(dx, dy) || 0.0001;
        const minDist = a.radius + b.radius;
        if (dist >= minDist) return;

        const nx = dx / dist;
        const ny = dy / dist;
        const overlap = minDist - dist;

        a.x -= nx * overlap * 0.5;
        a.y -= ny * overlap * 0.5;
        b.x += nx * overlap * 0.5;
        b.y += ny * overlap * 0.5;

        const avn = a.vx * nx + a.vy * ny;
        const bvn = b.vx * nx + b.vy * ny;
        const impulse = bvn - avn;

        a.vx += nx * impulse;
        a.vy += ny * impulse;
        b.vx -= nx * impulse;
        b.vy -= ny * impulse;

        // extra pop so collisions feel lively
        a.vx *= 1.03;
        a.vy *= 1.03;
        b.vx *= 1.03;
        b.vy *= 1.03;

        bounceWalls(a);
        bounceWalls(b);
      }

      function render() {
        for (const b of buddies) {
          const rot = Math.max(-12, Math.min(12, (b.vx + b.vy) * 0.03));
          b.node.style.transform = `translate3d(${b.x}px, ${b.y}px, 0) rotate(${rot}deg)`;
        }
      }

      function tick(ts) {
        const dt = Math.min(0.05, (ts - lastTs) / 1000);
        lastTs = ts;

        for (const b of buddies) {
          b.x += b.vx * dt;
          b.y += b.vy * dt;
          bounceWalls(b);
        }

        for (let i = 0; i < buddies.length; i++) {
          for (let j = i + 1; j < buddies.length; j++) {
            collide(buddies[i], buddies[j]);
          }
        }

        render();
        requestAnimationFrame(tick);
      }

      function startPhysics() {
        if (initialized) return;
        initialized = true;
        setupBuddies();
        render();
        requestAnimationFrame((ts) => {
          lastTs = ts;
          requestAnimationFrame(tick);
        });
      }

      let loadedCount = 0;
      buddyNodes.forEach((node) => {
        if (node.complete) loadedCount += 1;
        else node.addEventListener('load', () => {
          loadedCount += 1;
          if (loadedCount === buddyNodes.length) startPhysics();
        }, { once: true });
      });
      if (loadedCount === buddyNodes.length) startPhysics();

      window.addEventListener('resize', () => setupBuddies(false));
    }
  </script>
</body>
</html>
