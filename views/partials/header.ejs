<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= config.brand.siteName %></title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <div class="logo">
        <div class="logo-mark"></div>
        <div class="logo-text"><%= config.brand.siteName %></div>
      </div>
      <nav class="nav">
        <a href="/">Shop</a>

        <a class="cartLink" href="/cart" aria-label="Cart">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M6 6h15l-2 9H7L6 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M6 6 5 3H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor"/>
              <path d="M17 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor"/>
            </svg>
          </span>
          <span class="badge"><%= cartCount %></span>
        </a>

        <a class="navCheckout" href="/cart">Checkout</a>

        <a href="/bulk/standard">Standard Bulk</a>
        <a href="/bulk/buddies">Buddies Bulk</a>
        <a href="/admin">Admin</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
