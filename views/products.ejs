<%- include('partials/header', { config }) %>

<section class="card">
  <div class="row">
    <div>
      <h1 class="h1">Shop</h1>
      <p class="muted">Add items to your cart, then checkout.</p>
    </div>
    <div>
      <a class="btn btn-small" href="/cart">View Cart</a>
    </div>
  </div>

  <div class="gridCards">
    <% config.products.forEach(p => { 
         const minPrice = Math.min(...p.options.map(o => Number(o.price)));
    %>
      <div class="productCard">
        <img class="productImg" src="<%= p.image %>" alt="<%= p.name %>" />
        <div class="productMeta">
          <div class="productName"><%= p.name %></div>
          <div class="productPrice">from $<%= minPrice.toFixed(2) %></div>
        </div>

        <form method="POST" action="/cart/add" class="productForm">
          <input type="hidden" name="product_id" value="<%= p.id %>"/>
          <input type="hidden" name="next" value="/cart"/>

          <label class="small muted">Variant</label>
          <select name="option_id" required>
            <% p.options.forEach(o => { %>
              <option value="<%= o.id %>"><%= o.name %> — $<%= Number(o.price).toFixed(2) %></option>
            <% }) %>
          </select>

          <label class="small muted">Qty</label>
          <input type="number" name="qty" min="1" value="1" required />

          <button class="btn" type="submit">Add to Cart</button>
        </form>

        <form method="GET" action="/shipping" class="productForm" style="padding-top:0;">
          <input type="hidden" name="product_id" value="<%= p.id %>"/>
          <label class="small muted">Quick Checkout (optional)</label>
          <select name="option_id" required>
            <% p.options.forEach(o => { %>
              <option value="<%= o.id %>"><%= o.name %></option>
            <% }) %>
          </select>
          <input type="hidden" name="qty" value="1" />
          <button class="btn btn-small" type="submit">Checkout 1 Item</button>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="muted small" style="margin-top:10px;">
    Shipping is a flat <b>$15</b>. Bulk pricing auto-applies for Standard Plushies and Plushie Buddies when quantity hits tier minimums.
  </div>
</section>

<%- include('partials/footer') %>
