<%- include('partials/header', { config }) %>

<section class="card">
  <h1 class="h1">Thank you!</h1>
  <p class="muted">We received your order. If you included the order code in your payment note, we can match it faster.</p>

  <div class="summary">
    <div>
      <div class="muted">Order</div>
      <div class="orderCode"><%= order.order_code %></div>
    </div>
    <div>
      <div class="muted">Status</div>
      <div class="status status-payment_sent">payment_sent</div>
    </div>
    <div>
      <div class="muted">Total</div>
      <div class="total">$<%= Number(order.total_usd).toFixed(2) %></div>
    </div>
  </div>

  <a class="btn" href="/">Back to Shop</a>
</section>

<%- include('partials/footer') %>
