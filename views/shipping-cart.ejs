<%- include('partials/header', { config }) %>

<section class="card">
  <h1 class="h1">Shipping</h1>
  <p class="muted">Confirm your cart + enter shipping.</p>

  <div class="cartMini">
    <% lines.forEach(l => { %>
      <div class="miniRow">
        <div>
          <b><%= l.product_name %></b> — <%= l.option_name %>
          <span class="muted">x<%= l.qty %></span>
          <% if (l.unit_price !== l.base_price) { %>
            <span class="miniDiscount">Bulk ✅</span>
          <% } %>
        </div>
        <div>$<%= Number(l.line_total).toFixed(2) %></div>
      </div>
    <% }) %>

    <div class="miniRow totalRow">
      <div>Subtotal</div><div>$<%= Number(subtotalUsd).toFixed(2) %></div>
    </div>
    <div class="miniRow totalRow">
      <div>Shipping</div><div>$<%= Number(shippingUsd).toFixed(2) %></div>
    </div>
    <div class="miniRow totalRow">
      <div>Total</div><div class="total">$<%= Number(totalUsd).toFixed(2) %></div>
    </div>
  </div>

  <hr class="hr" />

  <form method="POST" action="/shipping-cart" class="grid">
    <h2 class="h2 full">Shipping Address</h2>

    <div class="shippingFields full">
      <div>
        <label>Full Name</label>
        <input name="ship_name" required />
      </div>
      <div>
        <label>Country</label>
        <input name="ship_country" value="USA" required />
      </div>

      <div>
        <label>Address Line 1</label>
        <input name="ship_line1" required />
      </div>

      <div>
        <label>Address Line 2 (optional)</label>
        <input name="ship_line2" />
      </div>

      <div>
        <label>City</label>
        <input name="ship_city" required />
      </div>

      <div>
        <label>State</label>
        <input name="ship_state" required />
      </div>

      <div>
        <label>ZIP</label>
        <input name="ship_zip" required />
      </div>
    </div>

    <div class="optional full">
      <label>Contact (optional: email or Telegram @)</label>
      <input name="contact" placeholder="you@example.com or @username" />
    </div>

    <button class="btn full" type="submit">Continue to Payment</button>
  </form>
</section>

<%- include('partials/footer') %>
